{
  "name": "Minerva_Chess_Bot",
  "version": "1.0.0",
  "description": "Telegram Bot for Minvera Chess engine",
  "main": "dist/index.js",
  "repository": "https://github.com/caando/Minerva_Chess.git",
  "author": "Woo Jia Hao, Zhang Jikun",
  "license": "GPL-3.0-only",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "bot": "yarn build && yarn start",
    "format:prettier": "prettier --config .prettierrc **/*.ts --write",
    "format:lint": "eslint **/*.ts --fix",
    "format": "yarn format:prettier && yarn format:lint",
    "husky": "cd ../ && npx husky install && npx husky add .husky/pre-commit \"cd ./bot && npx lint-staged\"",
    "migrate": "npx sequelize-cli db:migrate",
    "test": "jest --runInBand --verbose"
  },
  "devDependencies": {
    "@types/jest": "^29.5.3",
    "@types/ndjson": "^2.0.1",
    "@types/node": "^20.2.3",
    "@types/node-fetch": "^2.6.4",
    "@types/rewire": "^2.5.28",
    "@types/sqlite3": "^3.1.8",
    "@typescript-eslint/eslint-plugin": "^5.59.6",
    "@typescript-eslint/parser": "^5.59.6",
    "eslint": "^8.41.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-prettier": "^4.2.1",
    "husky": "^8.0.3",
    "jest": "^29.6.1",
    "lint-staged": "^13.2.2",
    "prettier": "^2.8.8",
    "reflect-metadata": "^0.1.13",
    "rewire": "^6.0.0",
    "sequelize-cli": "^6.6.0",
    "ts-jest": "^29.1.1",
    "tslint": "^6.1.3",
    "typescript": "^5.0.4"
  },
  "dependencies": {
    "axios": "^1.4.0",
    "axios-retry": "^3.5.0",
    "chess.js": "^1.0.0-beta.6",
    "dotenv": "^16.0.3",
    "https": "^1.0.0",
    "ndjson": "^2.0.0",
    "sequelize": "^6.31.1",
    "sequelize-typescript": "^2.1.5",
    "sqlite3": "^5.1.6",
    "telegraf": "^4.12.2"
  },
  "lint-staged": {
    "./**/*.{ts,json}": [
      "yarn format"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  }
}
